<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep this tooling dependency private while retaining its runtime assets in published utility outputs. -->
    <PackageReference Include="SharpFuzz" PrivateAssets="all" Publish="true" />
    <ProjectReference Include="../PiratePDF.Fuzz.Targets/PiratePDF.Fuzz.Targets.csproj" />
  </ItemGroup>

</Project>
